# Copy to .env; supply all mandatory values before starting.
# Use a bare DNS hostname, not a URL, IP address, path, or wildcard.
ANIMA_DOMAIN=
ACME_EMAIL=
ANIMA_OWNER_USER=
# Single quotes preserve every dollar sign in the Caddy bcrypt hash.
ANIMA_OWNER_PASSWORD_HASH=''
# Three separate random values, each at least 32 characters.
ANIMA_INTERNAL_API_KEY=
ANIMA_LOCAL_ADMIN_TOKEN=
ANIMA_KEYRING_PASSWORD=

# Optional model provider keys, supplied only to the daemon.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
